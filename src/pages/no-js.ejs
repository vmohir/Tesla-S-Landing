<!DOCTYPE html>
<html lang="en">
  <head>
    <%= require('../partials/header.html') %>
  </head>
  <body>
    <%= require('../partials/header.html') %>
    <main id="main">
      <%= require('../partials/intro.html') %>
      <!-- prettier-ignore -->
      <div>
      <% P100D.forEach(p => { %>
        <% p.hwy.forEach(k => { %>
          <div class="t<%= p.temp %> w<%= p.wheelsize %> ac-<%= p.ac %> kmh<%= k.kmh %>"><%= k.kilometers %></div>
        <% }); %>
      <% }); %>
    </div>
    </main>
  </body>
</html>
